# Environment and secrets (never commit)
.env
.env.*
.env.local
.env.production
.env.development

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Flask instance and databases
instance/
*.db
*.sqlite
*.sqlite3

# Migrations cache
migrations/__pycache__/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Build and packaging
build/
dist/
*.egg-info/

# Logs
*.log
pip-log.txt

# Credentials and keys
*.pem
*.key
*.crt
credentials/
secrets/

# Uploaded media (local dev)
server/static/uploads/*
!server/static/uploads/.gitkeep
