# Environment Configuration for Shoe Locker Frontend

# API Configuration
VITE_API_BASE_URL=http://localhost:5000

# Use mock API (for development without backend)
VITE_USE_MOCK_API=false

# Node Environment
NODE_ENV=development

# For production, update as follows:
# VITE_API_BASE_URL=https://api.shoelocker.com
# VITE_USE_MOCK_API=false
# NODE_ENV=production
