# =============================================================================
# ShoeLocker — environment template for danzykicks.com (Hostinger VPS)
# =============================================================================
# Copy to .env and fill in real values on the server only:
#   cp .env.example .env && nano .env
#
# NEVER commit .env — it is gitignored.
# =============================================================================

# --- Required secrets (generate with: python3 -c "import secrets; print(secrets.token_hex(32))") ---
POSTGRES_PASSWORD=CHANGE_ME
SECRET_KEY=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME

# --- Database ---
POSTGRES_USER=shoelocker
POSTGRES_DB=shoelocker

# --- Public URLs (danzykicks.com + Cloudflare) ---
# Baked into the frontend at build time — rebuild frontend after changing VITE_API_BASE_URL
VITE_API_BASE_URL=https://api.danzykicks.com
CORS_ORIGINS=https://danzykicks.com,https://www.danzykicks.com
FRONTEND_URL=https://danzykicks.com

# --- Docker networking (production: localhost only, host Nginx terminates HTTPS) ---
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
BACKEND_PORT=5000

# --- Gunicorn ---
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120

# --- First deploy only: set true to auto-seed admin/products, then set false ---
SEED_ON_START=false

# --- Email (optional) ---
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@danzykicks.com

# --- Stripe (optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- M-Pesa / Safaricom Daraja (optional) ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.danzykicks.com/payments/callback
MPESA_ENVIRONMENT=sandbox
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# --- Google Gemini product AI (optional) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
